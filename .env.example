# 굿퀘스천 MVP 환경변수 템플릿 — 실제 값은 .env.local에 (커밋 금지)
# 팀 공유 키: OpenAI 1개 · 타입캐스트 1개 (MVP 개발 분담안 §공용 규칙)

# OpenAI — Whisper STT(whisper-1) + LLM(gpt-4o-mini) 공용. 서버 전용
OPENAI_API_KEY=

# 타입캐스트 TTS — 백엔드 프록시 경유, 브라우저 비노출. 무료 플랜(월 3만 자·동시 2·출처 표기)
TYPECAST_API_KEY=

# 네이버 로그인 (기능명세서 1.1.2, T082) — Supabase 미지원이라 자체 OAuth 라우트(/auth/naver)가
# 직접 사용. 서버 전용. 미설정 시 로그인 화면 네이버 버튼은 준비 중 안내로 폴백.
# 발급: developers.naver.com 앱 등록(Callback URL: <origin>/auth/naver/callback 등록 필수)
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# Supabase — URL·publishable 키는 공개 가능(브라우저 노출 전제), service role 키는 서버 전용
NEXT_PUBLIC_SUPABASE_URL=https://lpiqyaqajlxhnvumvjvb.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_RKlC4d8Y-ZvBf924K_YNKA_x-t2aFjS
SUPABASE_SERVICE_ROLE_KEY=

# /dev/ui 리허설 갤러리 노출 (선택) — 로컬·preview 배포는 기본 허용.
# 스테이징이 production 타깃으로 배포될 때만 1로 설정한다. 실서비스 프로젝트에는 설정 금지.
# DEV_UI_ENABLED=1

# 역할별 모델 오버라이드 (선택 — 기본값 gpt-4o-mini, 품질 미달 시 개별 상향)
# ANALYSIS_MODEL=gpt-4o-mini
# GENERATION_MODEL=gpt-4o-mini
# STT_CORRECTION_MODEL=gpt-4o-mini
